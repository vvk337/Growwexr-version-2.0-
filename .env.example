# Growwezy Advisory - Market Data Feed Configuration
# ----------------------------------------------------
# To connect actual live/delayed financial quotes to the homepage ticker,
# obtain a free or pro API key from Twelve Data (https://twelvedata.com/pricing)
# and paste it below.
#
# Supported instruments:
# - Gold: XAU/USD
# - EUR/USD: EUR/USD
# - GBP/USD: GBP/USD
# - S&P 500: SPX
# - Nasdaq-100: NDX
# - Bitcoin: BTC/USD
#
# For Local Development:
# Copy this file to `.env.local` or `.env` and add your key:
# MARKET_DATA_API_KEY=your_actual_api_key_here
#
# For Vercel Production Deployment:
# Add `MARKET_DATA_API_KEY` to your Vercel Project Settings > Environment Variables.

MARKET_DATA_API_KEY=

