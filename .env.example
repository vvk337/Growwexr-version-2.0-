# Growwezy Advisory - Configuration
# ----------------------------------------------------

# Market Data Feed Configuration
# The homepage market ticker displays live/indicative financial quotes
# for key instruments (Gold, EUR/USD, GBP/USD, US 500 CFD, US 100 CFD, Bitcoin).
MARKET_FEED_ENDPOINT=https://crystalballmarkets.com/markets/api/v1/quotes.json?site=https://growwezy.com
MARKET_SITE_KEY=growwezy_live_rates_token_verified
MARKET_DATA_API_KEY=

# Google Sheets Lead Integration Webhook
# Paste your deployed Google Apps Script Web App URL here (see google-apps-script.js for 2-min setup):
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_deployment_id_here/exec

# For Local Development:
# Copy this file to `.env.local` or `.env` and set your credentials.
#
# For Vercel Production Deployment:
# Add `GOOGLE_SHEETS_WEBHOOK_URL` to Vercel Project Settings > Environment Variables.
